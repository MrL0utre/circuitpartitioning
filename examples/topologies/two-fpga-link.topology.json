{
  "$schema": "https://circuitpartitioning.org/schemas/v1/topology.schema.json",
  "schema_version": "1.0.0-draft.1",
  "type": "topology",
  "id": "two-fpga-link",
  "version": "1.0.0",
  "title": "Symmetric two-FPGA reference topology",
  "description": "Two identical FPGA parts connected with a 10 ns routing penalty.",
  "timing_unit": "ns",
  "symmetric": true,
  "parts": [
    {
      "id": "fpga-0",
      "label": "FPGA 0",
      "capacity": { "logic": 3, "registers": 2 }
    },
    {
      "id": "fpga-1",
      "label": "FPGA 1",
      "capacity": { "logic": 3, "registers": 2 }
    }
  ],
  "routing_costs": {
    "part_ids": ["fpga-0", "fpga-1"],
    "matrix": [
      [0, 10],
      [10, 0]
    ]
  },
  "links": [
    {
      "source": "fpga-0",
      "target": "fpga-1",
      "latency": 10,
      "signal_capacity": 128
    }
  ],
