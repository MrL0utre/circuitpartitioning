{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitpartitioning.org/schemas/v1/benchmark-run.schema.json",
  "title": "Normalized benchmark run",
  "type": "object",
  "required": [
    "schema_version", "type", "id", "circuit", "topology",
    "algorithm", "status", "started_at", "environment"
  ],
  "properties": {
    "$schema": { "const": "https://circuitpartitioning.org/schemas/v1/benchmark-run.schema.json" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "type": { "const": "benchmark-run" },
    "id": { "$ref": "common.schema.json#/$defs/resourceId" },
    "circuit": { "$ref": "common.schema.json#/$defs/resourceReference" },
    "topology": { "$ref": "common.schema.json#/$defs/resourceReference" },
    "partition": { "$ref": "common.schema.json#/$defs/resourceReference" },
    "algorithm": {
      "type": "object",
      "required": ["name", "version", "parameters"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object", "additionalProperties": true },
        "seed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "status": { "enum": ["succeeded", "failed", "timeout", "out-of-memory", "cancelled"] },
    "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "duration_ms": { "$ref": "common.schema.json#/$defs/nonNegativeNumber" },
    "memory_peak_mb": { "$ref": "common.schema.json#/$defs/nonNegativeNumber" },
    "environment": {
      "type": "object",
      "required": ["os", "architecture"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string" },
        "logical_cores": { "type": "integer", "minimum": 1 },
        "memory_mb": { "type": "integer", "minimum": 1 },
        "container_image": { "type": "string" },
        "details": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/metric" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/artifact" }
    },
    "error": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
      "then": { "required": ["duration_ms", "partition", "metrics"] }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["failed", "timeout", "out-of-memory"] } },
        "required": ["status"]
      },
      "then": { "required": ["error"] }
    }
  ],
  "additionalProperties": false
}
