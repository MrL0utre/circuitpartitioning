{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitpartitioning.org/schemas/v1/partition.schema.json",
  "title": "Circuit partition manifest",
  "type": "object",
  "required": [
    "schema_version", "type", "id", "version", "title",
    "conventions_version", "circuit", "topology", "assignment",
    "feasibility", "provenance", "created_at"
  ],
  "properties": {
    "$schema": { "const": "https://circuitpartitioning.org/schemas/v1/partition.schema.json" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "type": { "const": "partition" },
    "id": { "$ref": "common.schema.json#/$defs/resourceId" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "conventions_version": { "$ref": "common.schema.json#/$defs/semver" },
    "circuit": { "$ref": "common.schema.json#/$defs/resourceReference" },
    "topology": { "$ref": "common.schema.json#/$defs/resourceReference" },
    "assignment": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "items"],
          "properties": {
            "mode": { "const": "inline" },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["vertex_id", "part_id"],
                "properties": {
                  "vertex_id": { "$ref": "common.schema.json#/$defs/elementId" },
                  "part_id": { "$ref": "common.schema.json#/$defs/resourceId" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "artifact"],
          "properties": {
            "mode": { "const": "artifact" },
            "artifact": { "$ref": "common.schema.json#/$defs/artifact" }
          },
          "additionalProperties": false
        }
      ]
    },
    "feasibility": { "enum": ["unknown", "feasible", "infeasible"] },
    "algorithm": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object", "additionalProperties": true },
        "seed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/metric" }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "additionalProperties": false
}
